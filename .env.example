# titanium-video-downloader credentials template.
# Copy to `.env` and fill in only what you need — public sites need nothing.
# Lookup order: ./.env, then ~/.config/titanium-software/ti22-video-dl/.env
# (%APPDATA%\titanium-software\ti22-video-dl\.env on Windows).
# Real environment variables always win over .env values. Never commit .env.
# Names are app-qualified (TI22_VIDEO_DL_*) so shared shell scopes stay
# collision-free across Titanium packages.

# StudyGateway (login-required today).
TI22_VIDEO_DL_STUDYGATEWAY_EMAIL=
TI22_VIDEO_DL_STUDYGATEWAY_PASSWORD=

# Vimeo (public today; reserved for future private-video login).
TI22_VIDEO_DL_VIMEO_EMAIL=
TI22_VIDEO_DL_VIMEO_PASSWORD=

# Rumble (public today; reserved for future login needs).
TI22_VIDEO_DL_RUMBLE_EMAIL=
TI22_VIDEO_DL_RUMBLE_PASSWORD=

# RightNow Media (login-required; provider stubbed — coming soon).
TI22_VIDEO_DL_RIGHTNOWMEDIA_EMAIL=
TI22_VIDEO_DL_RIGHTNOWMEDIA_PASSWORD=

# Generic fallback (unknown-site slot).
TI22_VIDEO_DL_GENERIC_EMAIL=
TI22_VIDEO_DL_GENERIC_PASSWORD=
